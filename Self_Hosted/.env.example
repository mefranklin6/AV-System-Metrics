# Copy this file to .env before running Docker Compose.
# The app refuses to start until the example secrets below are changed.

# Required. Clients send this as: Authorization: Bearer <token>
BEARER_TOKEN=change-me-long-random-token

# Required. Used for the Compose-managed PostgreSQL user.
# Keep this URL-safe because docker-compose.yml embeds it in a PostgreSQL URL.
# The database container refuses to initialize with this example value.
POSTGRES_PASSWORD=change_me_url_safe_database_password

# Optional. Set EXPOSE_DATABASE=true to publish PostgreSQL for pgAdmin or
# similar database tools. Leave false for the safest default.
EXPOSE_DATABASE=false
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Optional. Host/IP and port where Docker publishes the app.
# 127.0.0.1 is safest when using a local reverse proxy or local testing.
# Use APP_HOST=0.0.0.0 for production if not using a reverse proxy.
APP_HOST=127.0.0.1
APP_PORT=8080

# Optional. CIDR allow-list for the direct client IP seen by the Go service.
# Leave blank to allow any source that can reach the published app port.
ALLOWED_NET=

# Optional. App image settings. The default image is published by GitHub Actions.
METRICS_INGEST_IMAGE=ghcr.io/mefranklin6/av-system-metrics/metrics-ingest:main
METRICS_INGEST_PULL_POLICY=always

# Optional. Container resource ceilings used by docker-compose.yml.
METRICS_INGEST_CPUS=0.50
METRICS_INGEST_MEMORY_LIMIT=128m
METRICS_INGEST_PIDS_LIMIT=100
POSTGRES_CPUS=1.00
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_PIDS_LIMIT=200

# Optional. Delete heartbeat records after a certain period of time.
PURGE_HEARTBEAT=true
HEARTBEAT_RETENTION_DAYS=30
# Cleanup commits small batches so a timeout preserves earlier progress.
# Lower batch size on busy/slow hosts; timeout applies to each batch.
HEARTBEAT_PURGE_BATCH_SIZE=1000
HEARTBEAT_PURGE_BATCH_TIMEOUT=30s

# Optional read-only Analytics API for the Metrics Visualizer and custom reporting apps.
# Disabled by default. When true, Compose starts a separate, token-protected,
# read-only API that reads PostgreSQL as the restricted metrics_reader role.
# Setting it back to false removes the API and disables the metrics_reader login.
# Run: docker compose up -d --remove-orphans (or update.sh) after changing it.
ENABLE_ANALYTICS_API=false
# Required when enabled. One or more comma-separated tokens (one per person or app
# allows rotation), each at least 32 random characters from A-Z a-z 0-9 . _ ~ + / = -
# such as the output of: openssl rand -hex 32. Do not reuse BEARER_TOKEN.
ANALYTICS_API_TOKEN=change-me-long-random-analytics-token
# Required when enabled. Password for the read-only metrics_reader database role.
# At least 16 characters from A-Z a-z 0-9 . _ ~ - only. Do not reuse POSTGRES_PASSWORD.
ANALYTICS_DB_PASSWORD=change_me_url_safe_analytics_password
# Host/IP and port where Docker publishes the Analytics API (127.0.0.1 = this host only).
ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=8081
# Optional comma-separated CIDR allow-list for the direct client IP, e.g. 10.20.0.0/16.
ANALYTICS_ALLOWED_NET=
# Optional comma-separated exact browser origins allowed by CORS, such as
# https://viz.example.edu. Required for the web build of the visualizer: list the
# origin the app is served from. Never *.
ANALYTICS_CORS_ORIGINS=
# Upper bound for the one-shot provisioning job (role, grants, index builds), in
# whole hours, minutes, or seconds such as 15m or 1h. The API starts after it.
ANALYTICS_PROVISION_TIMEOUT=15m
ANALYTICS_API_IMAGE=ghcr.io/mefranklin6/av-system-metrics/analytics-api:main
ANALYTICS_API_PULL_POLICY=always
ANALYTICS_API_CPUS=0.50
ANALYTICS_API_MEMORY_LIMIT=256m
ANALYTICS_API_PIDS_LIMIT=100

#### Do not modify below this line ####
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.database-expose-${EXPOSE_DATABASE}.yml:docker-compose.analytics-${ENABLE_ANALYTICS_API}.yml
